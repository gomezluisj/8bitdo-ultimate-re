# 8BitDo Ultimate Bluetooth (80NA) USB BOOT mode (VID 2dc8, PID 3208)
# Install:
#   sudo cp boot/99-8bitdo-boot.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="usb", ATTRS{idVendor}=="2dc8", ATTRS{idProduct}=="3208", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="2dc8", ATTRS{idProduct}=="3208", MODE="0660", TAG+="uaccess"
